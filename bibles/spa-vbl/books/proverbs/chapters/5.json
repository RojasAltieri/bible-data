        "H0859",
        "H0413",
        "H1931",
        "H4194",
        "H1571",
        "H0859",
        "H5375",
        "H5704",
        "H1931"
      ]
    },
    {
      "verse": "6",
      "text": "Ella no sigue el camino que conduce a la vida, sino que deambula sin saber que está perdida.",
      "strong": [
        "H1931",
        "H3808",

        "H1931",
        "H3588",
        "H3588",
        "H5647"
      ]
    },
    {
      "verse": "2",
      "text": "y ponte límites si tienes mucha hambre.",
      "strong": [
        "H1571",
        "H7760",
        "H5315",
        "H1167",
        "H7227",
        "H7458"
      ]
    },
    {
      "verse": "3",
      "text": "No seas glotón en sus finos banquetes, porque lo ofrecen con motivaciones engañosas.",

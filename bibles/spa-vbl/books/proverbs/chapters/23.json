        "H2308",
        "H0859",
        "H4480",
        "H1419",
        "H3045",
        "H2450",
        "H1571",
        "H2308",
        "H0859",
        "H5921",
        "H1931"
      ]
    },
    {
      "verse": "5",
      "text": "La riqueza desaparece en un abrir y cerrar de ojos, abriendo repentinamente alas, y volando al cielo como el águila.",
      "strong": [
        "H3588",
        "H7399",
        "H3588",
        "H0259",
        "H3588",
        "H3588",
        "H5869",
        "H6597",
        "H3671",
        "H3588",
        "H6524",
        "H0413",
        "H8064",
        "H3588",
        "H3588",
        "H5403"
      ]
    },
    {
      "verse": "6",
      "text": "No aceptes ir a comer con personas mezquinas, ni codicies sus finos banquetes,",
      "strong": [
        "H3808",
        "H0977",
        "H3212",
        "H5869",
        "H0398",
        "H5973",
        "H5315",
        "H3808",
        "H0183",
        "H1931",
        "H4960"
      ]
    },
    {
      "verse": "7",
      "text": "porque tal como son sus pensamientos, así son ellos. Ellos dicen: “¡Ven, come y bebe!” Pero en sus mentes no tienen ningún interés en ti.",
      "strong": [
        "H3588",
        "H3651",
        "H3588",
        "H3588",
        "H1931",
        "H4284",
        "H3651",
        "H3588",
        "H1931",
        "H1931",
        "H0559",
        "H3212",
        "H0398",
        "H3588",
        "H8354",
        "H3588",
        "H5973",
        "H1931",
        "H1077",
        "H1992",
        "H3605",
        "H5973",
        "H5973"
      ]
    },
    {
      "verse": "8",
      "text": "Vomitarás cada pedazo que hayas comido, y las palabras de aprecio se habrán consumido.",
      "strong": [
        "H6892",
        "H1697",
        "H1697",
        "H1265",
        "H0398",
        "H1571",
        "H1992",
        "H1697",
        "H1697",
        "H3045"
      ]
    },
    {
      "verse": "9",
      "text": "No hables con los tontos porque ellos se burlarán de tus palabras sabias.",
      "strong": [
        "H3588",
        "H1696",
        "H3588",
        "H3588",
        "H3588",
        "H1992",
        "H3045",
        "H3588",
        "H0859",
        "H1696",
        "H3045"
      ]
    },
    {
      "verse": "10",
      "text": "No muevas las fronteras antiguas, y no invadas los campos que pertenecen a huérfanos,",
      "strong": [
        "H3808",
        "H1992",
        "H5769",
        "H1571",
        "H3808",
        "H0582",
        "H7704",
        "H0834",
        "H0413",
        "H3490"
      ]
    },
    {

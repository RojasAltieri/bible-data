        "H1961",
        "H5921",
        "H1931",
        "H4960",
        "H3588",
        "H1931",
        "H7126",
        "H5973",
        "H4820"
      ]
    },
    {
      "verse": "4",
      "text": "No te desgastes tratando de volverte rico. ¡Sé sabio y no te afanes en ello!",

  "chapter": 23,
  "data": [
    {
      "verse": "1",
      "text": "Cuando te sientes a comer con un gobernante, ten cuidado con lo que te sirven,",
      "strong": [
        "H3588",
        "H3588",
        "H6440",
        "H0398",
        "H3588",
        "H0259",
        "H3045",
        "H3027",

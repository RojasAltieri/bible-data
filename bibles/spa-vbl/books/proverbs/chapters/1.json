        "H1121",
        "H0589",
        "H0518",
        "H3605",
        "H5315",
        "H2654",
        "H3808"
      ]
    },
    {
      "verse": "11",
      "text": "Podrán decirte: “Ven con nosotros. Escondámonos y alistémonos para matar a cierta persona. ¡Hagámosle una emboscada y vamos a divertirnos!",
      "strong": [
        "H3201",
        "H3212",
        "H5973",
        "H0587",
        "H5355",
        "H5704",
        "H7819",
        "H0413",
        "H3559",
        "H5315",
        "H0259",
        "H6119",
        "H5355",
        "H3212",
        "H0413"
      ]
    },
    {
      "verse": "12",
      "text": "¡Vamos y quemémoslo vivo, y llevémoslo a la tumba, aunque aún está sano!",
      "strong": [
        "H3212",
        "H1571",
        "H2416",
        "H1571",
        "H0413",
        "H1931",
        "H3588",
        "H5750",
        "H2063",
        "H7495"
      ]
    },
    {
      "verse": "13",
      "text": "Así podremos tomar sus pertenencias de valor, y llenaremos nuestros hogares con lo que habremos robado!",
      "strong": [
        "H3541",
        "H3201",
        "H3947",
        "H1931",
        "H4480",
        "H3365",
        "H1571",
        "H0587",
        "H5973",
        "H3605",
        "H1952"
      ]
    },
    {
      "verse": "14",
      "text": "¡Ven con nosotros y comprartiremos las ganancias!”",
      "strong": [
        "H3212",
        "H5973",
        "H3605",
        "H1571",
        "H1992"
      ]
    },
    {
      "verse": "15",
      "text": "Hijo mío, no sigas sus caminos. No vayas en la misma dirección con ellos.",

        "H4480",
        "H2896",
        "H4148"
      ]
    },
    {
      "verse": "8",
      "text": "Hijo mío, presta atención a la instrucción de tu padre, y no rechaces la enseñanza de tu madre.",
      "strong": [
        "H1121",
        "H0589",
        "H0413",
        "H1931",
        "H1121",
        "H0859",
        "H0001",
        "H1571",
        "H3808",
        "H1931",
        "H4148",
        "H1121",
        "H0859",
        "H0517"
      ]
    },
    {
      "verse": "9",
      "text": "Son como una corona de gracia para adornar tu cabeza, y como dijes para tu cuello.",
      "strong": [
        "H3588",
        "H3588",
        "H0259",
        "H5852",
        "H3588",
        "H2580",
        "H3588",
        "H0859",

        "H2454",
        "H6963",
        "H5414",
        "H1992",
        "H7339",
        "H1931",
        "H7442",
        "H5921",
        "H1992",
        "H7339"
      ]
    },
    {
      "verse": "21",
      "text": "Grita en las esquinas llenas, y explica su mensaje en las puertas de la ciudad:",
      "strong": [
        "H6963",
        "H5921",
        "H1992",
        "H6438",
        "H4392",
        "H1571",
        "H1931",
        "H5921",
        "H1992",
        "H8179",
        "H4480",
        "H1931",
        "H5892"
      ]
    },
    {
      "verse": "22",
      "text": "“¿Hasta cuándo amarán la insensatez, ustedes insensatos? ¿Hasta cuando, ustedes burladores, disfrutarán de sus burlas? ¿Hasta cuándo los tontos odiarán el conocimiento?",
      "strong": [
        "H5704",
        "H4970",
        "H1931",
        "H5036",
        "H5704",
        "H4970",
        "H3944",
        "H5704",
        "H1992",
        "H5704",
        "H4970",
        "H1992",
        "H1992",
        "H1847"
      ]
    },
    {
      "verse": "23",
      "text": "Presten atención a mis advertencias, y yo derramaré sobre ustedes mis pensamientos más profundos. Les explicaré todo lo que sé.",
      "strong": [
        "H0413",
        "H0589",
        "H1571",
        "H2009",
        "H8210",
        "H5921",
        "H0589",
        "H4284",
        "H5750",
        "H6009",
        "H0413",
        "H3605",
        "H1697",
        "H3045",
        "H3045"
      ]
    },
    {
      "verse": "24",
      "text": "“Porque yo los he llamado pero ustedes se han negado a escuchar. Les extendí mi mano, pero no les importó.",
      "strong": [
        "H3282",
        "H0589",
        "H0582",
        "H4392",
        "H7121",
        "H3588",
        "H3045",
        "H4191",

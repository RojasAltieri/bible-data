        "H3985",
        "H0413"
      ]
    },
    {
      "verse": "25",
      "text": "Ignoraron mi palabra, y no prestaron atención a mis advertencias.",
      "strong": [
        "H0589",
        "H1697",
        "H1571",
        "H3808",
        "H5414",
        "H0413",
        "H0589"
      ]
    },
    {
      "verse": "26",
      "text": "“Por eso me reiré de ustedes cuando estén en problemas. Me burlaré cuando el pánico se apodere de ustedes.",
      "strong": [
        "H5921",
        "H3651",
        "H0413",
        "H4480",
        "H1571",
        "H1961",
        "H5921",
        "H0413",
        "H1571",
        "H1571",
        "H3045",
        "H0622",
        "H4480"
      ]
    },
    {

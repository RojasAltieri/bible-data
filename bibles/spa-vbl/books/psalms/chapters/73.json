        "H1931",
        "H5869",
        "H5921",
        "H1931",
        "H1571",
        "H1931",
        "H3824",
        "H4392",
        "H5869",
        "H1892",
        "H1571"
      ]
    },
    {
      "verse": "8",
      "text": "Ellos se burlan de las personas y hablan con maldad. Con arrogancia y crueldad lanzan amenazas.",
      "strong": [
        "H1992",
        "H3045",
        "H7451",
        "H1992",
        "H5315",
        "H1571",
        "H1696",
        "H5973",
        "H7451",
        "H5973",
        "H1571",
        "H2555"
      ]
    },
    {

        "H3966",
        "H7965",
        "H3588",
        "H3588"
      ]
    },
    {
      "verse": "4",
      "text": "Parecen nunca enfermarse; lucen fuertes y saludables.",
      "strong": [
        "H3588",
        "H4013",
        "H3588"
      ]
    },
    {
      "verse": "5",
      "text": "Ellos no tienen problemas como los demás, y no son afectados por los desastres como el resto del mundo.",
      "strong": [
        "H1992",
        "H3808",
        "H1992",
        "H5973",
        "H5973",
        "H1571",
        "H1571",
        "H3808",
        "H3808",
        "H5921",
        "H5973",
        "H5973",
        "H5973",
        "H3499",
        "H5973",
        "H8398"
      ]
    },
    {
      "verse": "6",
      "text": "Su collar es su orgullo, y se visten con violencia.",
      "strong": [
        "H1931",
        "H1961",
        "H1931",
        "H1571",
        "H3651",
        "H5973",
        "H2555"
      ]
    },
    {
      "verse": "7",
      "text": "Sus ojos sobresalen por su gordura, y sus mentes están llenas de vanidad y egoísmo.",

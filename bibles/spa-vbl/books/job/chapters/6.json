        "H3588",
        "H5973",
        "H1931",
        "H3045",
        "H6723",
        "H1571",
        "H6256",
        "H4725",
        "H1961"
      ]
    },
    {
      "verse": "18",
      "text": "Las caravanas de camellos se apartan para buscar agua, pero no la encuentran y mueren.",
      "strong": [
        "H1992",
        "H4480",
        "H1581",
        "H3045",
        "H7311",
        "H5704",
        "H4325",
        "H3588",
        "H1870",
        "H1931",
        "H1571",
        "H4191"
      ]
    },
    {
      "verse": "19",
      "text": "Las caravanas de Tema buscaron, los viajeros de Saba se confiaron,",
      "strong": [
        "H1992",
        "H4480",
        "H3372",
        "H1245",
        "H0582",
        "H4480",
        "H3045"
      ]
    },
    {
      "verse": "20",
      "text": "pero sus esperanzas se desvanecieron: llegaron y no encontraron nada.",
      "strong": [
        "H3588",
        "H1931",
        "H3045",
        "H0935",
        "H3588",
        "H3588",
        "H3808"
      ]
    },
    {
      "verse": "21",
      "text": "“Ahora no ayudan en nada. Así de simple: ven mi problema y tienen miedo.",
      "strong": [
        "H6258",
        "H3808",
        "H5826",
        "H3588",
        "H3808",
        "H3588",
        "H3588",
        "H6615",
        "H7200",
        "H1961",
        "H3588",
        "H1961",
        "H3372"
      ]
    },
    {
      "verse": "22",
      "text": "¿Les he pedido algo? ¿Acaso les he pedido que sobornen a alguien a mi favor, usando su propio dinero?",
      "strong": [
        "H0413",
        "H4392",
        "H3920",
        "H0194",
        "H0413",
        "H4392",
        "H3588",
        "H3588",
        "H0376",
        "H3588",
        "H0589",
        "H7522",
        "H3588",
        "H3701"
      ]
    },
    {
      "verse": "23",
      "text": "¿Les he pedido que me rescaten de un enemigo? ¿Les he pedido que me salven de mis opresores?",
      "strong": [
        "H0413",
        "H4392",
        "H3027",
        "H0413",
        "H4480",
        "H0259",
        "H6862",
        "H0413",
        "H4392",
        "H3027",
        "H0413",
        "H4480",
        "H0589",
        "H6031"
      ]
    },
    {
      "verse": "24",
      "text": "Explíquenme esto y me callaré. Muéstrenme en qué me equivoco.",
      "strong": [
        "H2063",
        "H1571",
        "H0413",
        "H2790",
        "H5921",
        "H4100",
        "H0413"
      ]
    },
    {
      "verse": "25",
      "text": "Las palabras sinceras son dolorosas, ¿pero qué prueban sus argumentos?",
      "strong": [
        "H1992",
        "H1697",
        "H1961",
        "H3588",
        "H4100",
        "H1931",
        "H8394"
      ]
    },
    {
      "verse": "26",
      "text": "¿Van a discutir sobre lo que he dicho, cuando las palabras de alguien desesperado deberían dejar que el viento se las lleve?",
      "strong": [
        "H1980",
        "H0413",
        "H5921",
        "H4405",
        "H0834",
        "H4392",
        "H0559",
        "H3588",
        "H1992",
        "H4405",
        "H4480",
        "H0376",
        "H0605",
        "H5414",
        "H0834",
        "H1931",
        "H7307",
        "H3045",
        "H1992",
        "H5375"
      ]
    },
    {
      "verse": "27",
      "text": "¡Son capaces de jugar a los dados para ganarle un huérfano, así como son capaces de regatear con su amigo!",
      "strong": [
        "H1961",
        "H5921",
        "H5921",
        "H5921",
        "H5414",
        "H5921",
        "H0259",
        "H3490",
        "H3541",
        "H5921",
        "H1961",
        "H5921",
        "H5921",
        "H1931",
        "H7453"
      ]
    },
    {
      "verse": "28",
      "text": "¡Mírenme a los ojos y digan si les miento en la cara!",
      "strong": [
        "H5921",
        "H5921",
        "H5869",
        "H5921",
        "H0559",
        "H6440",
        "H5921",
        "H3576",
        "H5921",
        "H5921",
        "H6440"
      ]
    },
    {
      "verse": "29",
      "text": "¡No hablen así! ¡No sean injustos! Lo que digo es correcto.",
      "strong": [
        "H1961",
        "H1696",
        "H3541",
        "H1961",
        "H1961",
        "H1931",
        "H4994",
        "H0559",
        "H1961"
      ]
    },

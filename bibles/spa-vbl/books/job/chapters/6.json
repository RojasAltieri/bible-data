        "H3588",
        "H3588",
        "H5921",
        "H2342",
        "H5921",
        "H3220",
        "H5921",
        "H3651",
        "H1697",
        "H3966"
      ]
    },
    {
      "verse": "4",
      "text": "Porque las flechas del Todopoderoso están en mí; su veneno mina mi espíritu. Los terrores de Dios están alineados contra mí.",
      "strong": [
        "H3588",
        "H1992",
        "H8354",
        "H7706",
        "H1961",
        "H3588",
        "H0589",
        "H3588",
        "H2534",
        "H0589",
        "H7307",
        "H3588",
        "H1091",
        "H3588",
        "H0430",
        "H1961",
        "H5921",
        "H0589"
      ]
    },
    {
      "verse": "5",
      "text": "¿No rebuznan los burros salvajes cuando se les acaba la hierba? ¿No gime el ganado cuando no tiene comida?",
      "strong": [
        "H5921",
        "H5921",
        "H3588",
        "H5921",
        "H5921",
        "H5921",
        "H1877",
        "H5921",
        "H0584",
        "H5921",
        "H4735",
        "H3588",
        "H5921",
        "H3426",
        "H6720"
      ]
    },
    {
      "verse": "6",
      "text": "¿Se puede comer sin sal algo que no tiene sabor? ¿Tiene algún sabor la clara del huevo?",
      "strong": [
        "H3045",
        "H3201",
        "H0398",
        "H1097",
        "H4417",
        "H3920",
        "H0834",
        "H1097",
        "H3426",
        "H2940",
        "H3426",
        "H0259",
        "H2940",
        "H1931",
        "H3368",
        "H4480"
      ]
    },
    {
      "verse": "7",
      "text": "No puedo tocar ningún alimento, ¡la sola idea me hace sentir enfermo!",
      "strong": [
        "H3985",
        "H3201",
        "H5060",
        "H3605",
        "H0400",
        "H1931",
        "H1565",
        "H0413",
        "H6213",
        "H2470"
      ]
    },
    {
      "verse": "8",
      "text": "¡Oh, si pudiera tener lo que realmente quiero, que Dios me diera lo que más deseo!",
      "strong": [
        "H4310",
        "H0518",
        "H1961",
        "H1931",
        "H4310",
        "H2654",
        "H4310",
        "H0430",
        "H4310",
        "H5414",
        "H1931",
        "H4310",
        "H5750",
        "H0183"
      ]
    },
    {
      "verse": "9",
      "text": "¡Que Dios estuviera dispuesto a aplastarme hasta la muerte, que me dejara morir!",
      "strong": [
        "H3027",
        "H0430",
        "H3426",
        "H3559",
        "H0413",
        "H5704",
        "H1931",
        "H4194",
        "H3027",
        "H0413",
        "H5414",
        "H4191"
      ]
    },
    {
      "verse": "10",
      "text": "Pero aún me consuela saber, haciéndome feliz a través del dolor interminable, que nunca he rechazado las palabras de Dios.",
      "strong": [
        "H3588",
        "H5750",
        "H3588",
        "H5162",
        "H5046",
        "H3588",
        "H4480",
        "H2427",
        "H3588",
        "H3808",
        "H4392",
        "H1992",
        "H1697",
        "H3588",
        "H0430"
      ]
    },
    {
      "verse": "11",
      "text": "“¿Por qué debo seguir esperando si no tengo fuerzas? ¿Por qué debo seguir adelante si no sé lo que me va a pasar?",
      "strong": [
        "H3588",
        "H3588",
        "H0935",
        "H3176",
        "H3588",
        "H3588",
        "H2803",
        "H3581",
        "H3588",
        "H3588",
        "H0935",
        "H5750",
        "H3588",
        "H3588",
        "H4100",
        "H4100",
        "H3588",
        "H3588",
        "H1980",
        "H3588",
        "H5674"
      ]
    },
    {
      "verse": "12",
      "text": "¿Acaso soy fuerte como una roca? ¿Acaso soy de bronce?",
      "strong": [
        "H0194",
        "H0595",
        "H2389",
        "H0349",
        "H0259",
        "H6697",
        "H0194",
        "H0595",
        "H4480",
        "H5153"
      ]
    },
    {
      "verse": "13",
      "text": "¿Cómo puedo ayudarme a mí mismo ahora que cualquier posibilidad de éxito ha desaparecido?",
      "strong": [
        "H0349",
        "H3201",
        "H4480",
        "H0589",
        "H1931",
        "H6258",
        "H4480",
        "H3605",
        "H4480",
        "H3541"
      ]
    },
    {
      "verse": "14",
      "text": "Quien no es amable con un amigo ha dejado de respetar al Todopoderoso.",
      "strong": [
        "H4310",
        "H3808",
        "H1961",
        "H3700",
        "H5973",
        "H0259",
        "H7453",
        "H3541",
        "H8667",
        "H4480",
        "H0413",
        "H7706"
      ]
    },
    {
      "verse": "15",
      "text": "Mis hermanos han actuado con el mismo engaño que un arroyo del desierto, aguas caudalosas en el desierto que se desvanecen.",
      "strong": [
        "H0589",
        "H0251",
        "H4191",
        "H5973",
        "H5674",
        "H1931",
        "H4820",
        "H0834",
        "H0259",
        "H5158",
        "H4480",

  "chapter": 6,
  "data": [
    {
      "verse": "1",
      "text": "Entonces Job respondió:",
      "strong": [
        "H0227",
        "H0347",
        "H6030"
      ]
    },
    {
      "verse": "2",
      "text": "“Si se pudiera pesar mi dolor y poner mis problemas en una balanza",

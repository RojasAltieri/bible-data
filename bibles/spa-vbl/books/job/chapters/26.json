      "strong": [
        "H1931",
        "H2063",
        "H6174",
        "H6440",
        "H0430",
        "H2063"
      ]
    },
    {
      "verse": "7",
      "text": "Extiende el cielo del norte sobre el espacio vacío; cuelga el mundo sobre la nada.",

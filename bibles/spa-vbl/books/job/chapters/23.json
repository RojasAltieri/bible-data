        "H3808",
        "H4392",
        "H6923",
        "H1931",
        "H3808",
        "H3808",
        "H3808",
        "H3808",
        "H0413",
        "H3808",
        "H1961",
        "H3808",
        "H1931",
        "H0400",
        "H3808",
        "H0349",
        "H3605",
        "H3117"
      ]
    },
    {
      "verse": "13",
      "text": "“Pero Dios es inmutable: ¿quién puede desviarlo de sus propósitos? Él hace todo lo que quiere hacer.",
      "strong": [
        "H3588",
        "H0430",
        "H1931",

        "H1931",
        "H4310",
        "H2654",
        "H6213"
      ]
    },
    {
      "verse": "14",
      "text": "Así que terminará lo que ha planeado para mí, y tiene muchos planes para mí.",
      "strong": [
        "H3588",
        "H3588",
        "H2007",
        "H3588",
        "H3541",

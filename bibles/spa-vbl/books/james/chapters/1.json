        "G5281",
        "G2532",
        "H3651",
        "G2532",
        "G3588",
        "G2443",
        "G3588",
        "H1961",
        "G3367",
        "G3367",
        "H6588"
      ]
    },
    {
      "verse": "5",
      "text": "Si alguno de ustedes necesita sabiduría, pídala a Dios, que da a todos generosamente y sin retenciones.",

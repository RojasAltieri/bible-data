{"version":"swh-neno","book":"psalms","chapter":3,"data":[{"verse":"1","text":"Ee Bwana, tazama adui zangu walivyo wengi!"},{"verse":"2","text":"Wengi wanasema juu yangu,"},{"verse":"3","text":"Lakini wewe, Ee Bwana, ni ngao pande zote;"},{"verse":"4","text":"Ninamlilia Bwana kwa sauti kuu,"},{"verse":"5","text":"Ninajilaza na kupata usingizi;"},{"verse":"6","text":"Sitaogopa makumi elfu ya adui,"},{"verse":"7","text":"Ee Bwana, amka!"},{"verse":"8","text":"Kwa maana wokovu watoka kwa Bwana."}]}
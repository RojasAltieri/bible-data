{"version":"swh-neno","book":"psalms","chapter":150,"data":[{"verse":"1","text":"Msifuni Bwana."},{"verse":"2","text":"Msifuni kwa matendo yake makuu,"},{"verse":"3","text":"Msifuni kwa mvumo wa tarumbeta,"},{"verse":"4","text":"msifuni kwa matari na kucheza,"},{"verse":"5","text":"msifuni kwa matoazi yaliayo,"},{"verse":"6","text":"Kila chenye pumzi na kimsifu Bwana."}]}
{"version":"swh-neno","book":"psalms","chapter":138,"data":[{"verse":"1","text":"Nitakusifu wewe, Ee Bwana, kwa moyo wangu wote,"},{"verse":"2","text":"Nitasujudu nikielekea Hekalu lako takatifu,"},{"verse":"3","text":"Nilipoita, ulinijibu;"},{"verse":"4","text":"Wafalme wote wa dunia wakusifu wewe Ee Bwana,"},{"verse":"5","text":"Wao na waimbe kuhusu njia za Bwana,"},{"verse":"6","text":"Ingawa Bwana yuko juu,"},{"verse":"7","text":"Nijapopita katikati ya shida,"},{"verse":"8","text":"Bwana atatimiza kusudi lake kwangu,"}]}
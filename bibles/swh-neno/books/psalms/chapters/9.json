{"version":"swh-neno","book":"psalms","chapter":9,"data":[{"verse":"1","text":"Ee Bwana, nitakutukuza kwa moyo wangu wote,"},{"verse":"2","text":"Nitafurahi na kushangilia ndani yako."},{"verse":"3","text":"Adui zangu wamerudi nyuma,"},{"verse":"4","text":"Kwa maana umetetea haki yangu na msimamo wangu;"},{"verse":"5","text":"Umekemea mataifa na kuwaangamiza waovu;"},{"verse":"6","text":"Uharibifu usiokoma umempata adui,"},{"verse":"7","text":"Bwana anatawala milele,"},{"verse":"8","text":"Mungu atahukumu ulimwengu kwa haki,"},{"verse":"9","text":"Bwana ni kimbilio la watu wanaoonewa,"},{"verse":"10","text":"Wote wanaolijua jina lako watakutumaini wewe,"},{"verse":"11","text":"Mwimbieni Bwana sifa, amefanywa mtawala Sayuni,"},{"verse":"12","text":"Kwa maana yeye alipizaye kisasi cha damu hukumbuka,"},{"verse":"13","text":"Ee Bwana, tazama jinsi walivyo wengi adui zangu wanaonitesa!"},{"verse":"14","text":"ili niweze kutangaza sifa zako"},{"verse":"15","text":"Mataifa wameanguka kwenye shimo walilolichimba,"},{"verse":"16","text":"Bwana anajulikana kwa haki yake,"},{"verse":"17","text":"Waovu wataishia kuzimu,"},{"verse":"18","text":"Lakini mhitaji hatasahaulika siku zote,"},{"verse":"19","text":"Ee Bwana, inuka, usimwache binadamu ashinde."},{"verse":"20","text":"Ee Bwana, wapige kwa hofu,"}]}
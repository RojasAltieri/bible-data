{"version":"swh-neno","book":"psalms","chapter":2,"data":[{"verse":"1","text":"Kwa nini mataifa wanashauriana kufanya mabaya,"},{"verse":"2","text":"Wafalme wa dunia wanajipanga"},{"verse":"3","text":"Wanasema, “Tuvunje minyororo yao"},{"verse":"4","text":"Yeye atawalaye mbinguni hucheka,"},{"verse":"5","text":"Kisha huwakemea katika hasira yake"},{"verse":"6","text":"“Nimemtawaza Mfalme wangu"},{"verse":"7","text":"Nitatangaza amri ya Bwana:"},{"verse":"8","text":"Niombe, nami nitayafanya mataifa"},{"verse":"9","text":"Utawatawala kwa fimbo ya chuma"},{"verse":"10","text":"Kwa hiyo, ninyi wafalme, kuweni na hekima;"},{"verse":"11","text":"Mtumikieni Bwana kwa hofu"},{"verse":"12","text":"Mbusu Mwana, asije akakasirika"}]}
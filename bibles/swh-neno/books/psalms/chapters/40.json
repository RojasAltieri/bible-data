{"version":"swh-neno","book":"psalms","chapter":40,"data":[{"verse":"1","text":"Nilimngoja Bwana kwa saburi,"},{"verse":"2","text":"Akanipandisha kutoka shimo la uharibifu,"},{"verse":"3","text":"Akaweka wimbo mpya kinywani mwangu,"},{"verse":"4","text":"Heri mtu yule amfanyaye Bwana kuwa tumaini lake,"},{"verse":"5","text":"Ee Bwana Mungu wangu,"},{"verse":"6","text":"Dhabihu na sadaka hukuvitaka,"},{"verse":"7","text":"Ndipo niliposema, “Mimi hapa, nimekuja:"},{"verse":"8","text":"Ee Mungu wangu,"},{"verse":"9","text":"Nimehubiri haki katika kusanyiko kubwa,"},{"verse":"10","text":"Sikuficha haki yako moyoni mwangu;"},{"verse":"11","text":"Ee Bwana, usizuilie huruma zako,"},{"verse":"12","text":"Kwa maana taabu zisizo na hesabu zimenizunguka,"},{"verse":"13","text":"Ee Bwana, uwe radhi kuniokoa;"},{"verse":"14","text":"Wote wanaotafuta kuuondoa uhai wangu,"},{"verse":"15","text":"Wale waniambiao, “Aha! Aha!”"},{"verse":"16","text":"Lakini wote wakutafutao"},{"verse":"17","text":"Lakini bado mimi ni maskini na mhitaji;"}]}
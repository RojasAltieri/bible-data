{"version":"swh-neno","book":"psalms","chapter":84,"data":[{"verse":"1","text":"Ee Bwana Mwenye Nguvu Zote,"},{"verse":"2","text":"Nafsi yangu inatamani sana,"},{"verse":"3","text":"Hata shomoro amejipatia makao,"},{"verse":"4","text":"Heri wale wanaokaa nyumbani mwako,"},{"verse":"5","text":"Heri wale ambao nguvu zao ziko kwako,"},{"verse":"6","text":"Wanapopita katika Bonde la Baka,84:6 Yaani Bonde la Vilio."},{"verse":"7","text":"Huendelea toka nguvu hadi nguvu,"},{"verse":"8","text":"Ee Bwana Mungu Mwenye Nguvu Zote, sikia maombi yangu;"},{"verse":"9","text":"Ee Mungu, uitazame ngao yetu,"},{"verse":"10","text":"Siku moja katika nyua zako ni bora"},{"verse":"11","text":"Kwa kuwa Bwana ni jua na ngao,"},{"verse":"12","text":"Ee Bwana Mwenye Nguvu Zote,"}]}
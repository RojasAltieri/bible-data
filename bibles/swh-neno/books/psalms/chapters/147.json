{"version":"swh-neno","book":"psalms","chapter":147,"data":[{"verse":"1","text":"Msifuni Bwana."},{"verse":"2","text":"Bwana hujenga Yerusalemu,"},{"verse":"3","text":"Anawaponya waliovunjika mioyo"},{"verse":"4","text":"Huzihesabu nyota"},{"verse":"5","text":"Bwana wetu ni mkuu na mwenye uwezo mwingi,"},{"verse":"6","text":"Bwana huwahifadhi wanyenyekevu"},{"verse":"7","text":"Mwimbieni Bwana kwa shukrani,"},{"verse":"8","text":"Yeye huzifunika anga kwa mawingu,"},{"verse":"9","text":"Huwapa chakula mifugo"},{"verse":"10","text":"Furaha yake haipo katika nguvu za farasi,"},{"verse":"11","text":"Bwana hupendezwa na wale wamchao,"},{"verse":"12","text":"Mtukuze Bwana, ee Yerusalemu,"},{"verse":"13","text":"kwa maana huimarisha makomeo ya malango yako"},{"verse":"14","text":"Huwapa amani mipakani mwenu"},{"verse":"15","text":"Hutuma amri yake duniani,"},{"verse":"16","text":"Anatandaza theluji kama sufu"},{"verse":"17","text":"Huvurumisha mvua yake ya mawe kama changarawe."},{"verse":"18","text":"Hutuma neno lake na kuviyeyusha,"},{"verse":"19","text":"Amemfunulia Yakobo neno lake,"},{"verse":"20","text":"Hajafanya hivyo kwa taifa lingine lolote,"}]}
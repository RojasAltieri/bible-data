{"version":"swh-neno","book":"psalms","chapter":126,"data":[{"verse":"1","text":"Bwana alipowarejeza mateka Sayuni,"},{"verse":"2","text":"Vinywa vyetu vilijaa kicheko,"},{"verse":"3","text":"Bwana ametutendea mambo makuu,"},{"verse":"4","text":"Ee Bwana, turejeshee watu wetu waliotekwa,"},{"verse":"5","text":"Wapandao kwa machozi"},{"verse":"6","text":"Yeye azichukuaye mbegu zake"}]}
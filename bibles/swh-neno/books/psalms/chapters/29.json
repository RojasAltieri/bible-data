{"version":"swh-neno","book":"psalms","chapter":29,"data":[{"verse":"1","text":"Mpeni Bwana, enyi mashujaa,"},{"verse":"2","text":"Mpeni Bwana utukufu unaostahili jina lake;"},{"verse":"3","text":"Sauti ya Bwana iko juu ya maji;"},{"verse":"4","text":"Sauti ya Bwana ina nguvu;"},{"verse":"5","text":"Sauti ya Bwana huvunja mierezi;"},{"verse":"6","text":"Hufanya Lebanoni irukaruke kama ndama,"},{"verse":"7","text":"Sauti ya Bwana hupiga kwa miali"},{"verse":"8","text":"Sauti ya Bwana hutikisa jangwa;"},{"verse":"9","text":"Sauti ya Bwana huzalisha ayala,"},{"verse":"10","text":"Bwana huketi akiwa ametawazwa juu ya gharika;"},{"verse":"11","text":"Bwana huwapa watu wake nguvu;"}]}
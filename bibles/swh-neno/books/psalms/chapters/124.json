{"version":"swh-neno","book":"psalms","chapter":124,"data":[{"verse":"1","text":"Kama Bwana asingalikuwa upande wetu;"},{"verse":"2","text":"kama Bwana asingalikuwa upande wetu,"},{"verse":"3","text":"wakati hasira yao ilipowaka dhidi yetu,"},{"verse":"4","text":"mafuriko yangalitugharikisha,"},{"verse":"5","text":"maji yaendayo kasi"},{"verse":"6","text":"Bwana asifiwe,"},{"verse":"7","text":"Tumeponyoka kama ndege"},{"verse":"8","text":"Msaada wetu ni katika jina la Bwana,"}]}
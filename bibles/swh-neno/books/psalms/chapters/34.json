{"version":"swh-neno","book":"psalms","chapter":34,"data":[{"verse":"1","text":"Nitamtukuza Bwana nyakati zote,"},{"verse":"2","text":"Nafsi yangu itajisifu katika Bwana,"},{"verse":"3","text":"Mtukuzeni Bwana pamoja nami,"},{"verse":"4","text":"Nilimtafuta Bwana naye akanijibu,"},{"verse":"5","text":"Wale wamtazamao hutiwa nuru,"},{"verse":"6","text":"Maskini huyu alimwita Bwana, naye akamsikia,"},{"verse":"7","text":"Malaika wa Bwana hufanya kituo"},{"verse":"8","text":"Onjeni mwone kwamba Bwana ni mwema,"},{"verse":"9","text":"Mcheni Bwana enyi watakatifu wake,"},{"verse":"10","text":"Wana simba wenye nguvu"},{"verse":"11","text":"Njooni, watoto wangu, mnisikilize,"},{"verse":"12","text":"Yeyote kati yenu anayependa uzima"},{"verse":"13","text":"basi auzuie ulimi wake na mabaya,"},{"verse":"14","text":"Aache uovu, atende mema,"},{"verse":"15","text":"Macho ya Bwana huwaelekea wenye haki,"},{"verse":"16","text":"Uso wa Bwana uko kinyume na watendao maovu,"},{"verse":"17","text":"Wenye haki hulia, naye Bwana huwasikia,"},{"verse":"18","text":"Bwana yu karibu na waliovunjika moyo,"},{"verse":"19","text":"Mwenye haki ana mateso mengi,"},{"verse":"20","text":"huhifadhi mifupa yake yote,"},{"verse":"21","text":"Ubaya utamuua mtu mwovu,"},{"verse":"22","text":"Bwana huwakomboa watumishi wake,"}]}
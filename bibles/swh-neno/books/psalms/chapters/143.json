{"version":"swh-neno","book":"psalms","chapter":143,"data":[{"verse":"1","text":"Ee Bwana, sikia sala yangu,"},{"verse":"2","text":"Usimhukumu mtumishi wako,"},{"verse":"3","text":"Adui hunifuatilia,"},{"verse":"4","text":"Kwa hiyo roho yangu inazimia ndani yangu,"},{"verse":"5","text":"Nakumbuka siku za zamani;"},{"verse":"6","text":"Nanyoosha mikono yangu kwako,"},{"verse":"7","text":"Ee Bwana, unijibu haraka,"},{"verse":"8","text":"Asubuhi uniletee neno la upendo wako usiokoma,"},{"verse":"9","text":"Ee Bwana, uniokoe na adui zangu,"},{"verse":"10","text":"Nifundishe kufanya mapenzi yako,"},{"verse":"11","text":"Ee Bwana, kwa ajili ya jina lako, hifadhi maisha yangu,"},{"verse":"12","text":"Kwa upendo wako usiokoma,"}]}
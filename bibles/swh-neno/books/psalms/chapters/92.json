{"version":"swh-neno","book":"psalms","chapter":92,"data":[{"verse":"1","text":"Ni vyema kumshukuru Bwana"},{"verse":"2","text":"kuutangaza upendo wako asubuhi,"},{"verse":"3","text":"kwa zeze yenye nyuzi kumi"},{"verse":"4","text":"Ee Bwana, kwa kuwa matendo yako yamenifurahisha,"},{"verse":"5","text":"Ee Bwana, tazama jinsi yalivyo makuu matendo yako,"},{"verse":"6","text":"Mjinga hafahamu,"},{"verse":"7","text":"ingawa waovu huchipua kama majani"},{"verse":"8","text":"Bali wewe, Ee Bwana,"},{"verse":"9","text":"Ee Bwana, hakika adui zako,"},{"verse":"10","text":"Umeitukuza pembe92:10 Pembe inawakilisha nguvu. yangu kama ile ya nyati dume,"},{"verse":"11","text":"Macho yangu yamewaona adui zangu wakishindwa,"},{"verse":"12","text":"Wenye haki watastawi kama mtende,"},{"verse":"13","text":"waliopandwa katika nyumba ya Bwana,"},{"verse":"14","text":"Wakati wa uzee watakuwa bado wanazaa matunda,"},{"verse":"15","text":"wakitangaza, “Bwana ni mkamilifu;"}]}
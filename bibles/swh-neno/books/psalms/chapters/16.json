{"version":"swh-neno","book":"psalms","chapter":16,"data":[{"verse":"1","text":"Ee Mungu, uniweke salama,"},{"verse":"2","text":"Nilimwambia Bwana, “Wewe ndiwe Bwana wangu;"},{"verse":"3","text":"Kwa habari ya watakatifu walioko duniani,"},{"verse":"4","text":"Huzuni itaongezeka kwa wale"},{"verse":"5","text":"Bwana umeniwekea fungu langu na kikombe changu;"},{"verse":"6","text":"Alama za mipaka zimeniangukia mahali pazuri,"},{"verse":"7","text":"Nitamsifu Bwana ambaye hunishauri,"},{"verse":"8","text":"Nimemweka Bwana mbele yangu daima."},{"verse":"9","text":"Kwa hiyo moyo wangu unafurahia, na ulimi wangu unashangilia;"},{"verse":"10","text":"kwa maana hutaniacha kaburini,"},{"verse":"11","text":"Umenijulisha njia ya uzima;"}]}
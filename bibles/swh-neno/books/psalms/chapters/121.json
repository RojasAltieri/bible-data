{"version":"swh-neno","book":"psalms","chapter":121,"data":[{"verse":"1","text":"Nayainua macho yangu nitazame vilima,"},{"verse":"2","text":"Msaada wangu hutoka kwa Bwana,"},{"verse":"3","text":"Hatauacha mguu wako uteleze,"},{"verse":"4","text":"hakika, yeye alindaye Israeli"},{"verse":"5","text":"Bwana anakulinda,"},{"verse":"6","text":"jua halitakudhuru mchana,"},{"verse":"7","text":"Bwana atakukinga na madhara yote,"},{"verse":"8","text":"Bwana atakulinda unapoingia na unapotoka,"}]}
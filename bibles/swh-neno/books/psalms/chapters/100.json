{"version":"swh-neno","book":"psalms","chapter":100,"data":[{"verse":"1","text":"Mpigieni Bwana kelele za shangwe, dunia yote."},{"verse":"2","text":"Mwabuduni Bwana kwa furaha;"},{"verse":"3","text":"Jueni kwamba Bwana ndiye Mungu."},{"verse":"4","text":"Ingieni malangoni mwake kwa shukrani"},{"verse":"5","text":"Kwa maana Bwana ni mwema"}]}
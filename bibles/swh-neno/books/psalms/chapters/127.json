{"version":"swh-neno","book":"psalms","chapter":127,"data":[{"verse":"1","text":"Bwana asipoijenga nyumba,"},{"verse":"2","text":"Mnajisumbua bure kuamka mapema"},{"verse":"3","text":"Wana ni urithi utokao kwa Bwana,"},{"verse":"4","text":"Kama mishale mikononi mwa shujaa"},{"verse":"5","text":"Heri mtu ambaye podo lake"}]}
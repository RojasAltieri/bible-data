{"version":"swh-neno","book":"psalms","chapter":111,"data":[{"verse":"1","text":"Msifuni Bwana."},{"verse":"2","text":"Kazi za Bwana ni kuu,"},{"verse":"3","text":"Kazi zake zimejaa fahari na utukufu,"},{"verse":"4","text":"Amefanya maajabu yake yakumbukwe,"},{"verse":"5","text":"Huwapa chakula wale wanaomcha,"},{"verse":"6","text":"Amewaonyesha watu wake uwezo wa kazi zake,"},{"verse":"7","text":"Kazi za mikono yake ni za uaminifu na haki,"},{"verse":"8","text":"Zinadumu milele na milele,"},{"verse":"9","text":"Aliwapa watu wake ukombozi,"},{"verse":"10","text":"Kumcha Bwana ndicho chanzo cha hekima,"}]}
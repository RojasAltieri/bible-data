{"version":"swh-neno","book":"psalms","chapter":27,"data":[{"verse":"1","text":"Bwana ni nuru yangu na wokovu wangu,"},{"verse":"2","text":"Waovu watakaposogea dhidi yangu"},{"verse":"3","text":"Hata jeshi linizunguke pande zote,"},{"verse":"4","text":"Jambo moja ninamwomba Bwana,"},{"verse":"5","text":"Kwa kuwa siku ya shida,"},{"verse":"6","text":"Kisha kichwa changu kitainuliwa"},{"verse":"7","text":"Isikie sauti yangu nikuitapo, Ee Bwana,"},{"verse":"8","text":"Moyo wangu unasema kuhusu wewe,"},{"verse":"9","text":"Usinifiche uso wako,"},{"verse":"10","text":"Hata kama baba yangu na mama wakiniacha,"},{"verse":"11","text":"Nifundishe njia yako, Ee Bwana,"},{"verse":"12","text":"Usiniachilie kwa nia za adui zangu,"},{"verse":"13","text":"Nami bado nina tumaini hili:"},{"verse":"14","text":"Mngojee Bwana,"}]}
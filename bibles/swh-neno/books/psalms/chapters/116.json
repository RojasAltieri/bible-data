{"version":"swh-neno","book":"psalms","chapter":116,"data":[{"verse":"1","text":"Ninampenda Bwana kwa maana amesikia sauti yangu;"},{"verse":"2","text":"Kwa sababu amenitegea sikio lake,"},{"verse":"3","text":"Kamba za mauti zilinizunguka,"},{"verse":"4","text":"Ndipo nikaliitia jina la Bwana:"},{"verse":"5","text":"Bwana ni mwenye neema na haki,"},{"verse":"6","text":"Bwana huwalinda wanyenyekevu,"},{"verse":"7","text":"Ee nafsi yangu, tulia tena,"},{"verse":"8","text":"Kwa kuwa wewe, Ee Bwana,"},{"verse":"9","text":"ili niweze kutembea mbele za Bwana,"},{"verse":"10","text":"Niliamini, kwa hiyo nilisema,"},{"verse":"11","text":"Katika taabu yangu nilisema,"},{"verse":"12","text":"Nimrudishie Bwana nini"},{"verse":"13","text":"Nitakiinua kikombe cha wokovu"},{"verse":"14","text":"Nitazitimiza nadhiri zangu kwa Bwana"},{"verse":"15","text":"Kifo cha watakatifu kina thamani"},{"verse":"16","text":"Ee Bwana, hakika mimi ni mtumishi wako,"},{"verse":"17","text":"Nitakutolea dhabihu ya kukushukuru"},{"verse":"18","text":"Nitazitimiza nadhiri zangu kwa Bwana"},{"verse":"19","text":"katika nyua za nyumba ya Bwana,"}]}
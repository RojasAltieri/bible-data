{"version":"swh-neno","book":"psalms","chapter":15,"data":[{"verse":"1","text":"Bwana, ni nani awezaye kukaa"},{"verse":"2","text":"Ni yule aendaye pasipo mawaa,"},{"verse":"3","text":"na hana masingizio ulimini mwake,"},{"verse":"4","text":"ambaye humdharau mtu mbaya,"},{"verse":"5","text":"Yeye akopeshaye fedha yake bila riba,"}]}
{"version":"swh-neno","book":"psalms","chapter":132,"data":[{"verse":"1","text":"Ee Bwana, mkumbuke Daudi"},{"verse":"2","text":"Aliapa kiapo kwa Bwana"},{"verse":"3","text":"“Sitaingia nyumbani mwangu"},{"verse":"4","text":"sitaruhusu usingizi katika macho yangu,"},{"verse":"5","text":"mpaka nitakapompatia Bwana mahali,"},{"verse":"6","text":"Tulisikia habari hii huko Efrathi,"},{"verse":"7","text":"“Twendeni kwenye makao yake,"},{"verse":"8","text":"inuka, Ee Bwana, uje mahali pako pa kupumzikia,"},{"verse":"9","text":"Makuhani wako na wavikwe haki,"},{"verse":"10","text":"Kwa ajili ya Daudi mtumishi wako,"},{"verse":"11","text":"Bwana alimwapia Daudi kiapo,"},{"verse":"12","text":"kama wanao watashika Agano langu"},{"verse":"13","text":"Kwa maana Bwana ameichagua Sayuni,"},{"verse":"14","text":"“Hapa ni mahali pangu pa kupumzika milele na milele;"},{"verse":"15","text":"Nitambariki kwa kumpa mahitaji tele:"},{"verse":"16","text":"Nitawavika makuhani wake wokovu,"},{"verse":"17","text":"“Hapa nitamchipushia Daudi pembe,132:17 Pembe inawakilisha nguvu."},{"verse":"18","text":"Adui zake nitawavika aibu,"}]}
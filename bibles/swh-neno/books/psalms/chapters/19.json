{"version":"swh-neno","book":"psalms","chapter":19,"data":[{"verse":"1","text":"Mbingu zinatangaza utukufu wa Mungu,"},{"verse":"2","text":"Siku baada ya siku zinatoa habari,"},{"verse":"3","text":"Hakuna msemo wala lugha,"},{"verse":"4","text":"Sauti yao imeenea duniani pote,"},{"verse":"5","text":"linafanana na bwana arusi"},{"verse":"6","text":"Huchomoza upande mmoja wa mbingu,"},{"verse":"7","text":"Sheria ya Bwana ni kamilifu,"},{"verse":"8","text":"Maagizo ya Bwana ni kamili,"},{"verse":"9","text":"Kumcha Bwana ni utakatifu,"},{"verse":"10","text":"Ni za thamani kuliko dhahabu,"},{"verse":"11","text":"Kwa hizo mtumishi wako anaonywa,"},{"verse":"12","text":"Ni nani awezaye kutambua makosa yake?"},{"verse":"13","text":"Mlinde mtumishi wako na dhambi za makusudi,"},{"verse":"14","text":"Maneno ya kinywa changu"}]}
{"version":"swh-neno","book":"psalms","chapter":146,"data":[{"verse":"1","text":"Msifuni Bwana!146:1 Msifuni Bwana kwa Kiebrania ni Hallelu Yah."},{"verse":"2","text":"Nitamsifu Bwana maisha yangu yote;"},{"verse":"3","text":"Usiweke tumaini lako kwa wakuu,"},{"verse":"4","text":"Roho yao itokapo hurudi mavumbini,"},{"verse":"5","text":"Heri yeye ambaye Mungu wa Yakobo ni msaada wake,"},{"verse":"6","text":"Muumba wa mbingu na nchi,"},{"verse":"7","text":"Naye huwapatia haki walioonewa"},{"verse":"8","text":"Bwana huwafumbua vipofu macho,"},{"verse":"9","text":"Bwana huwalinda wageni"},{"verse":"10","text":"Bwana atamiliki milele,"}]}
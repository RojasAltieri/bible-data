{"version":"swh-neno","book":"psalms","chapter":1,"data":[{"verse":"1","text":"Heri mtu yule ambaye"},{"verse":"2","text":"Bali huifurahia sheria ya Bwana,"},{"verse":"3","text":"Mtu huyo ni kama mti uliopandwa"},{"verse":"4","text":"Sivyo walivyo waovu!"},{"verse":"5","text":"Kwa hiyo waovu hawatastahimili hukumu,"},{"verse":"6","text":"Kwa maana Bwana huziangalia njia za mwenye haki,"}]}
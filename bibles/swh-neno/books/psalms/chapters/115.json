{"version":"swh-neno","book":"psalms","chapter":115,"data":[{"verse":"1","text":"Sio kwetu sisi, Ee Bwana, sio kwetu sisi,"},{"verse":"2","text":"Kwa nini mataifa waseme,"},{"verse":"3","text":"Mungu wetu yuko mbinguni,"},{"verse":"4","text":"Lakini sanamu zao ni za fedha na dhahabu,"},{"verse":"5","text":"Zina vinywa, lakini haziwezi kusema,"},{"verse":"6","text":"zina masikio, lakini haziwezi kusikia,"},{"verse":"7","text":"zina mikono, lakini haziwezi kupapasa,"},{"verse":"8","text":"Wale wanaozitengeneza watafanana nazo,"},{"verse":"9","text":"Ee nyumba ya Israeli, mtumainini Bwana,"},{"verse":"10","text":"Ee nyumba ya Aroni, mtumainini Bwana,"},{"verse":"11","text":"Ninyi mnaomcha, mtumainini Bwana,"},{"verse":"12","text":"Bwana anatukumbuka na atatubariki:"},{"verse":"13","text":"atawabariki wale wanaomcha Bwana,"},{"verse":"14","text":"Bwana na awawezeshe kuongezeka,"},{"verse":"15","text":"Mbarikiwe na Bwana"},{"verse":"16","text":"Mbingu zilizo juu sana ni mali ya Bwana,"},{"verse":"17","text":"Sio wafu wanaomsifu Bwana,"},{"verse":"18","text":"bali ni sisi tunaomtukuza Bwana,"}]}
{"version":"swh-neno","book":"psalms","chapter":41,"data":[{"verse":"1","text":"Heri mtu yule anayemjali mnyonge,"},{"verse":"2","text":"Bwana atamlinda na kuyahifadhi maisha yake,"},{"verse":"3","text":"Bwana atamtegemeza awapo mgonjwa kitandani,"},{"verse":"4","text":"Nilisema, “Ee Bwana nihurumie,"},{"verse":"5","text":"Adui zangu wanasema kwa hila,"},{"verse":"6","text":"Kila anapokuja mtu kunitazama,"},{"verse":"7","text":"Adui zangu wote hunongʼonezana dhidi yangu,"},{"verse":"8","text":"“Ugonjwa mbaya sana umempata,"},{"verse":"9","text":"Hata rafiki yangu wa karibu niliyemwamini,"},{"verse":"10","text":"Lakini wewe, Ee Bwana, nihurumie,"},{"verse":"11","text":"Najua kwamba wapendezwa nami,"},{"verse":"12","text":"Katika uadilifu wangu unanitegemeza"},{"verse":"13","text":"Msifuni Bwana, Mungu wa Israeli,"}]}
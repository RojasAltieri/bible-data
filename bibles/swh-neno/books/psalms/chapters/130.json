{"version":"swh-neno","book":"psalms","chapter":130,"data":[{"verse":"1","text":"Kutoka vilindini ninakulilia, Ee Bwana."},{"verse":"2","text":"Ee Bwana, sikia sauti yangu."},{"verse":"3","text":"Kama wewe, Ee Bwana, ungeweka kumbukumbu ya dhambi,"},{"verse":"4","text":"Lakini kwako kuna msamaha,"},{"verse":"5","text":"Namngojea Bwana, nafsi yangu inangojea,"},{"verse":"6","text":"Nafsi yangu inamngojea Bwana"},{"verse":"7","text":"Ee Israeli, mtumaini Bwana,"},{"verse":"8","text":"Yeye mwenyewe ataikomboa Israeli"}]}
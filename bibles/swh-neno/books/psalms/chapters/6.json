{"version":"swh-neno","book":"psalms","chapter":6,"data":[{"verse":"1","text":"Ee Bwana, usinikemee katika hasira yako,"},{"verse":"2","text":"Unirehemu Bwana,"},{"verse":"3","text":"Nafsi yangu ina uchungu mwingi."},{"verse":"4","text":"Geuka Ee Bwana, unikomboe,"},{"verse":"5","text":"Hakuna mtu anayekukumbuka"},{"verse":"6","text":"Nimechakaa kwa kulia kwa huzuni;"},{"verse":"7","text":"Macho yangu yamedhoofika kwa kuhuzunika,"},{"verse":"8","text":"Kaeni mbali nami, ninyi nyote mtendao mabaya,"},{"verse":"9","text":"Bwana amesikia kilio changu kwa huruma,"},{"verse":"10","text":"Adui zangu wote wataaibika na kufadhaika,"}]}
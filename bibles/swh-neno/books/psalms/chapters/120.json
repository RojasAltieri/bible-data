{"version":"swh-neno","book":"psalms","chapter":120,"data":[{"verse":"1","text":"Katika dhiki yangu namwita Bwana,"},{"verse":"2","text":"Ee Bwana, uniokoe kutoka midomo ya uongo"},{"verse":"3","text":"Atakufanyia nini,"},{"verse":"4","text":"Atakuadhibu kwa mishale mikali ya shujaa,"},{"verse":"5","text":"Ole wangu kwa kuwa naishi Mesheki,"},{"verse":"6","text":"Nimeishi muda mrefu mno"},{"verse":"7","text":"Mimi ni mtu wa amani;"}]}
{"version":"swh-neno","book":"psalms","chapter":21,"data":[{"verse":"1","text":"Ee Bwana, mfalme huzifurahia nguvu zako."},{"verse":"2","text":"Umempa haja ya moyo wake"},{"verse":"3","text":"Ulimkaribisha kwa baraka tele"},{"verse":"4","text":"Alikuomba maisha, nawe ukampa,"},{"verse":"5","text":"Kutokana na ushindi uliompa, utukufu wake ni mkubwa,"},{"verse":"6","text":"Hakika umempa baraka za milele,"},{"verse":"7","text":"Kwa kuwa mfalme anamtumaini Bwana;"},{"verse":"8","text":"Mkono wako utawashika adui zako wote,"},{"verse":"9","text":"Wakati utakapojitokeza"},{"verse":"10","text":"Utawaangamiza wazao wao kutoka duniani,"},{"verse":"11","text":"Ingawa watapanga mabaya dhidi yako"},{"verse":"12","text":"kwa kuwa utawafanya wakimbie"},{"verse":"13","text":"Ee Bwana, utukuzwe katika nguvu zako,"}]}
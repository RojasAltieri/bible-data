{"version":"swh-neno","book":"micah","chapter":6,"data":[{"verse":"1","text":"Sikiliza asemalo Bwana:"},{"verse":"2","text":"Sikilizeni, ee milima, mashtaka ya Bwana,"},{"verse":"3","text":"“Watu wangu, nimewatendea nini?"},{"verse":"4","text":"Nimewatoa kutoka Misri na kuwakomboa"},{"verse":"5","text":"Watu wangu, kumbukeni jinsi Balaki mfalme wa Moabu"},{"verse":"6","text":"Nimjie Bwana na kitu gani na kusujudu"},{"verse":"7","text":"Je, Bwana atafurahishwa na kondoo dume elfu,"},{"verse":"8","text":"Amekuonyesha yaliyo mema, ee mwanadamu."},{"verse":"9","text":"Sikiliza! Bwana anauita mji:"},{"verse":"10","text":"Je, bado nisahau, ee nyumba ya uovu,"},{"verse":"11","text":"Je, naweza kuhukumu kuwa"},{"verse":"12","text":"Matajiri wake ni wajeuri;"},{"verse":"13","text":"Kwa hiyo, nimeanza kukuharibu,"},{"verse":"14","text":"Mtakula lakini hamtashiba;"},{"verse":"15","text":"Mtapanda lakini hamtavuna;"},{"verse":"16","text":"Mmezishika sheria za Omri"}]}
{"version":"swh-neno","book":"hosea","chapter":11,"data":[{"verse":"1","text":"“Wakati Israeli alipokuwa mtoto, nilimpenda,"},{"verse":"2","text":"Lakini kadiri nilivyomwita Israeli,"},{"verse":"3","text":"Mimi ndiye niliyemfundisha Efraimu kutembea,"},{"verse":"4","text":"Niliwaongoza kwa kamba za huruma ya kibinadamu,"},{"verse":"5","text":"“Je, hawatarudi Misri,"},{"verse":"6","text":"Panga zitametameta katika miji yao,"},{"verse":"7","text":"Watu wangu wamedhamiria kuniacha."},{"verse":"8","text":"“Efraimu, ninawezaje kukuacha?"},{"verse":"9","text":"Sitatimiza hasira yangu kali,"},{"verse":"10","text":"Watamfuata Bwana;"},{"verse":"11","text":"Watakuja wakitetemeka"},{"verse":"12","text":"Efraimu amenizunguka kwa uongo,"}]}
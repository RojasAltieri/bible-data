{"version":"swh-neno","book":"hosea","chapter":10,"data":[{"verse":"1","text":"Israeli alikuwa mzabibu uliostawi sana,"},{"verse":"2","text":"Moyo wao ni mdanganyifu,"},{"verse":"3","text":"Kisha watasema, “Hatuna mfalme"},{"verse":"4","text":"Wanaweka ahadi nyingi,"},{"verse":"5","text":"Watu wanaoishi Samaria huogopa"},{"verse":"6","text":"Itachukuliwa kwenda Ashuru"},{"verse":"7","text":"Samaria na mfalme wake wataelea"},{"verse":"8","text":"Mahali pa kuabudia sanamu pa uovu10:8 Yaani Aveni kwa Kiebrania, kumaanisha Beth-Aveni, jina lingine la Betheli kwa dhihaka. pataharibiwa:"},{"verse":"9","text":"“Tangu siku za Gibea, mmetenda dhambi, ee Israeli,"},{"verse":"10","text":"Wakati nitakapopenda, nitawaadhibu;"},{"verse":"11","text":"Efraimu ni mtamba wa ngʼombe aliyefundishwa"},{"verse":"12","text":"Jipandieni wenyewe haki,"},{"verse":"13","text":"Lakini mmepanda uovu,"},{"verse":"14","text":"mngurumo wa vita utainuka dhidi ya watu wako,"},{"verse":"15","text":"Ndivyo itakavyotokea kwako, ee Betheli,"}]}
{"version":"swh-neno","book":"isaiah","chapter":50,"data":[{"verse":"1","text":"Hili ndilo asemalo Bwana:"},{"verse":"2","text":"Nilipokuja, kwa nini hakuwepo hata mmoja?"},{"verse":"3","text":"Ninalivika anga weusi na kufanya nguo ya gunia"},{"verse":"4","text":"Bwana Mwenyezi amenipa ulimi uliofundishwa,"},{"verse":"5","text":"Bwana Mwenyezi amezibua masikio yangu,"},{"verse":"6","text":"Niliwapa mgongo wangu wale wanipigao,"},{"verse":"7","text":"Kwa sababu Bwana Mwenyezi ananisaidia,"},{"verse":"8","text":"Yeye anipatiaye haki yangu yu karibu."},{"verse":"9","text":"Ni Bwana Mwenyezi anisaidiaye mimi."},{"verse":"10","text":"Ni nani miongoni mwenu amchaye Bwana,"},{"verse":"11","text":"Lakini sasa, ninyi nyote mnaowasha mioto,"}]}
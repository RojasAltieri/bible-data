{"version":"swh-neno","book":"isaiah","chapter":61,"data":[{"verse":"1","text":"Roho wa Bwana Mwenyezi yu juu yangu,"},{"verse":"2","text":"kutangaza mwaka wa Bwana uliokubaliwa,"},{"verse":"3","text":"na kuwapa mahitaji"},{"verse":"4","text":"Watajenga upya magofu ya zamani"},{"verse":"5","text":"Wageni watayachunga makundi yenu,"},{"verse":"6","text":"Nanyi mtaitwa makuhani wa Bwana,"},{"verse":"7","text":"Badala ya aibu yao"},{"verse":"8","text":"“Kwa maana Mimi, Bwana, napenda haki,"},{"verse":"9","text":"Wazao wao watajulikana miongoni mwa mataifa,"},{"verse":"10","text":"Ninafurahia sana katika Bwana,"},{"verse":"11","text":"Kwa maana kama vile ardhi ifanyavyo chipukizi kuota,"}]}
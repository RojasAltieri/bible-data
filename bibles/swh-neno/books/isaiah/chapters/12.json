{"version":"swh-neno","book":"isaiah","chapter":12,"data":[{"verse":"1","text":"Katika siku ile utasema:"},{"verse":"2","text":"Hakika Mungu ni wokovu wangu;"},{"verse":"3","text":"Kwa furaha mtachota maji"},{"verse":"4","text":"Katika siku hiyo mtasema:"},{"verse":"5","text":"Mwimbieni Bwana, kwa kuwa ametenda mambo makuu,"},{"verse":"6","text":"Pazeni sauti mwimbe kwa furaha, watu wa Sayuni,"}]}
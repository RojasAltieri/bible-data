{"version":"ben-irv","book":"psalms","chapter":67,"data":[{"verse":"1","text":"ঈশ্বর আমাদেরকে করুণা কর"},{"verse":"2","text":"যাতে করে পৃথিবীতে পথ প্রকাশিত হয়"},{"verse":"3","text":"ঈশ্বর, জাতিরা তোমার প্রশংসা করুক,"},{"verse":"4","text":"অহ, জাতিরা উল্লাস করুক"},{"verse":"5","text":"ঈশ্বর, জাতিরা তোমার প্রশংসা করে,"},{"verse":"6","text":"ঈশ্বর, পৃথিবী তার ফল দিয়েছে"},{"verse":"7","text":"ঈশ্বর আমাদের আশীর্বাদ করবেন"}]}
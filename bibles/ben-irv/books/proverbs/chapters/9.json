{"version":"ben-irv","book":"proverbs","chapter":9,"data":[{"verse":"1","text":"প্রজ্ঞা নিজের ঘর তৈরী করেছে,"},{"verse":"2","text":"সে নিজের পশুর মাংস প্রস্তুত করেছে;"},{"verse":"3","text":"সে নিজের দাসীদেরকে পাঠিয়েছে,"},{"verse":"4","text":"“যে সরল, সে এই জায়গায় আসুক;"},{"verse":"5","text":"এস, আমার খাদ্য দ্রব্য খাও,"},{"verse":"6","text":"নির্বোধদের সঙ্গ ছেড়ে জীবন ধারণ কর,"},{"verse":"7","text":"যে নিন্দককে শিক্ষা দেয়, সে লজ্জা পায়,"},{"verse":"8","text":"নিন্দককে অনুযোগ কোরো না,"},{"verse":"9","text":"জ্ঞানবানকে [শিক্ষা] দাও,"},{"verse":"10","text":"পবিত্র সদাপ্রভুকে ভয় করাই প্রজ্ঞার শুরু,"},{"verse":"11","text":"কারণ আমার থেকেই তোমার আয়ু বাড়বে,"},{"verse":"12","text":"তুমি যদি জ্ঞানবান হও,"},{"verse":"13","text":"বুদ্ধিহীন স্ত্রীলোক ঝগড়াটি,"},{"verse":"14","text":"সে নিজের ঘরের দরজায় বসে,"},{"verse":"15","text":"সে পথিকদেরকে ডাকে,"},{"verse":"16","text":"যে অবোধ, সে এই জায়গায় আসুক,"},{"verse":"17","text":"চুরি করা জল মিষ্টি,"},{"verse":"18","text":"কিন্তু সে জানে না যে,"}]}